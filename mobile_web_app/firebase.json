          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cafeana-7fa42",
          "configurations": {
            "android": "1:495457806256:android:ddc519fbea98d7aa1d5875",
            "web": "1:495457806256:web:d52ff4f29118ff371d5875"
          }
        }
      }
    }
  }
